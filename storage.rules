rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /proofs/{filename} {
      // Allow anonymous users to upload (Phase 1)
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      // Admin can read all (and public can read if they have the direct link)
      allow read: if true;
    }
  }
}
